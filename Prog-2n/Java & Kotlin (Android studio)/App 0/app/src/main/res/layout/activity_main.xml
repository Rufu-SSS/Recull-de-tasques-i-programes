<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/Hor_gui1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="100dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/Hor_gui2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="200dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/Hor_gui3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="300dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/Hor_gui4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="400dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/Hor_gui5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="500dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/Hor_gui6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="600dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/Vert_gui1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="100dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/Vert_gui2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="200dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/Vert_gui3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="300dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/Vert_gui4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="411dp" />

    <Button
        android:id="@+id/btn_comma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=","
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui1" />

    <Button
        android:id="@+id/btn_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui2"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui1"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui1" />

    <Button
        android:id="@+id/btn_equal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="="
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui4"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui2"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui1" />

    <Button
        android:id="@+id/btn_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui1"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui2" />

    <Button
        android:id="@+id/btn_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui1"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui2"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui1"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui2" />

    <Button
        android:id="@+id/btn_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui1"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui3"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui2"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui2" />

    <Button
        android:id="@+id/btn_suma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui1"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui4"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui3"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui2" />

    <Button
        android:id="@+id/btn_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui2"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui3" />

    <Button
        android:id="@+id/btn_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui2"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui2"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui1"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui3" />

    <Button
        android:id="@+id/btn_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="6"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui2"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui3"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui2"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui3" />

    <Button
        android:id="@+id/btn_resta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui2"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui4"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui3"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui3" />

    <Button
        android:id="@+id/btn_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui3"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui4" />

    <Button
        android:id="@+id/btn_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="8"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui3"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui2"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui1"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui4" />

    <Button
        android:id="@+id/btn_9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="9"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui3"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui3"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui2"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui4" />

    <Button
        android:id="@+id/btn_mult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="x"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui3"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui4" />

    <Button
        android:id="@+id/btn_div"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui4"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui4"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui3"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui5" />

    <Button
        android:id="@+id/btn_clear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AC"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui4"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui5" />

    <Button
        android:id="@+id/btn_clear2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="C"
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui4"
        app:layout_constraintEnd_toStartOf="@+id/Vert_gui3"
        app:layout_constraintStart_toStartOf="@+id/Vert_gui2"
        app:layout_constraintTop_toTopOf="@+id/Hor_gui5" />

    <EditText
        android:id="@+id/txt_resultat"
        android:layout_width="238dp"
        android:layout_height="73dp"
        android:ems="10"
        android:inputType="text|textAutoComplete"
        android:text=""
        app:layout_constraintBottom_toTopOf="@+id/Hor_gui5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>