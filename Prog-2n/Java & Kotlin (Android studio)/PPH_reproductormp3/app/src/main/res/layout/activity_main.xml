<?xml version="1.0" encoding="utf-8"?>
<!-- Contenidor arrel: ocupa tota la pantalla amb fons negre fosc -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    tools:context=".MainActivity">

    <!-- ScrollView perquè tot el contingut sigui desplaçable verticalment -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="48dp"
            android:paddingBottom="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Portada de la cançó: quadrat de 260dp, retalla la imatge -->
            <ImageView
                android:id="@+id/imgCover"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_marginBottom="32dp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                tools:srcCompat="@tools:sample/avatars" />
            <!-- tools:srcCompat només es veu a l'editor, no a l'app real -->

            <!-- Títol de la cançó: blanc, negreta, tallat amb "..." si és massa llarg -->
            <TextView
                android:id="@+id/songTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Títol de la cançó"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="4dp"/>

            <!-- Nom de l'artista: gris clar, més petit que el títol -->
            <TextView
                android:id="@+id/tvArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Artista"
                android:textColor="#AAAAAA"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="28dp"/>

            <!-- Barra de progrés: vermella sobre fons gris
                 S'actualitza des de Java cada 500ms via handler.postDelayed() -->
            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="#FF0000"
                android:thumbTint="#FF0000"
                android:progressBackgroundTint="#444444"
                android:layout_marginBottom="4dp"/>

            <!-- Fila amb el temps actual (esquerra) i la durada total (dreta) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp">

                <!-- Temps actual: s'actualitza amb formatarTemps() cada 500ms -->
                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>

                <!-- Durada total: es fixa un cop a inicialitzarPlayer() -->
                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="00:00"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Fila de botons: repartits equitativament amb layout_weight -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <!-- Botó Anterior: fons transparent amb efecte ripple -->
                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="#FFFFFF"
                    android:scaleType="fitCenter"
                    android:padding="8dp"/>

                <!-- Botó Pause -->
                <ImageButton
                    android:id="@+id/btnPause"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_pause"
                    app:tint="#FFFFFF"
                    android:scaleType="fitCenter"
                    android:padding="8dp"/>

                <!-- Botó Play: més gran (64dp) amb fons circular vermell -->
                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_play_button"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#FFFFFF"
                    android:scaleType="fitCenter"
                    android:padding="14dp"/>

                <!-- Botó Stop: usa ic_delete perquè Android no té icona stop nativa -->
                <ImageButton
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_delete"
                    app:tint="#FFFFFF"
                    android:scaleType="fitCenter"
                    android:padding="8dp"/>

                <!-- Botó Següent -->
                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="#FFFFFF"
                    android:scaleType="fitCenter"
                    android:padding="8dp"/>
            </LinearLayout>

            <!-- Capçalera de la secció de llista estil YouTube Music -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A continuació"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- Llista de cançons: nestedScrollingEnabled=false perquè
                 el ScrollView pare gestioni tot el desplaçament -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>